{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:provfold:schema:config:1.0",
  "title": "ProvFold aggregation configuration",
  "type": "object",
  "required": [
    "analysis_id",
    "primary_comparisons",
    "primary_evidence_tiers",
    "direction_states",
    "eligible_family_states",
    "eligible_mapping_states",
    "eligible_record_states",
    "target_rank"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"type": "string", "minLength": 1},
    "primary_comparisons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "primary_evidence_tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "direction_states": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "eligible_family_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "eligible_mapping_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "eligible_record_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "target_rank": {"type": "string"},
    "minimum_support": {"type": "integer", "minimum": 1},
    "maximum_opposition": {"type": "integer", "minimum": 0},
    "conflict_policy": {"enum": ["abstain", "opposition"]},
    "comparator_scope": {
      "enum": ["primary", "all_eligible"],
      "description": "Scope for the four naive comparator summaries only; provenance-aware aggregation always uses primary_comparisons and primary_evidence_tiers."
    }
  },
  "additionalProperties": false
}
